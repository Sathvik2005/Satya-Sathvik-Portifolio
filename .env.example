# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (optional - only needed if using database)
# DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# Replit Configuration (optional)
# REPL_ID=

# SMTP settings (required for contact form email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-app-password

# Email routing
CONTACT_TO_EMAIL=your-inbox@example.com
CONTACT_FROM_EMAIL=portfolio@yourdomain.com
